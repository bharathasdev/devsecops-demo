pipeline {
    agent 
    {
        docker { image 'node:20-alpine', args '-u root', reuseNode 'true' }
        
    }
    stages {
        stage('Checkout') {
            steps {
                sh 'node --version'
                sh 'npm --version'
                sh 'echo checkout repo'
                git branch: 'jenkins', url: 'https://github.com/bharathasdev/devsecops-demo.git'


            }
        }

        stage('Unit Test') {
            steps {
                cleanWs()
                sh 'echo "Running unit tests..."'
                sh 'npm install'
                
            }
        }
        stage('Static Code Analysis') {
            steps {
                sh 'echo "Running static code analysis..."'
            }
        }        
        
        stage('Build') {
            steps {
                sh 'echo "Building..."'
            }
        }
        stage('Docker Build') {
            steps {
                sh 'echo "Building Docker image..."'
            }
        }
  

        stage('scan Image') {
            steps {
                sh 'echo "Scanning for vulnerabilities..."'
            }
        }

        stage('Docker Push') {
            steps {
                sh 'echo "Pushing Docker image to registry..."'
            }
        }

        stage('Update-K8s-Deployment'){
            steps {
                sh 'echo "Updating Kubernetes deployment..."'
            }
        }
        
        stage('Test') {
            steps {
                sh 'echo "Testing..."'
            }
        }
        
        stage('Deploy') {
            steps {
                sh 'echo "Deploying..."'
            }
        }
    }
    
    post {
        // Clean after build
        always {
            cleanWs(cleanWhenNotBuilt: false,
                    deleteDirs: true,
                    disableDeferredWipeout: true,
                    notFailBuild: true,
                    patterns: [[pattern: '.gitignore', type: 'INCLUDE'],
                               [pattern: '.propsfile', type: 'EXCLUDE']])
        }
    }
}