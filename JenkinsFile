pipeline {
    agent 
    {
        docker { 
            image 'node:20'
            args '-u root -v /var/run/docker.sock:/var/run/docker.sock'
            reuseNode true
        }
        
    }
    stages {
        // stage('Checkout') {
        //     steps {
        //         sh 'node --version'
        //         sh 'npm --version'
        //         sh 'echo checkout repo'
        //         checkout([
        //             $class: 'GitSCM',
        //             branches: [[name: '*/jenkins']],
        //             userRemoteConfigs: [[url: 'https://github.com/bharathasdev/devsecops-demo.git']]
        //         ])
        //         // git branch: 'jenkins', url: 'https://github.com/bharathasdev/devsecops-demo.git'


        //     }
        // }

         stage('Static Code Analysis') {
            steps {
                
                sh 'echo "Running static code analysis..."'
                sh 'npm install'
                sh 'npm run lint'
            }
        }      

        stage('Unit Test') {
            steps {
               
                sh 'echo "Running unit tests..."'               
                sh 'npm test'
                
            }
        }
         
        
        stage('Build') {
            steps {
                sh 'echo "Building..."'
                sh 'npm run build'
            }
        }
        stage('Docker Build') {
            steps {
                sh 'echo "Building Docker image..."'
            }
        }
  

        stage('scan Image') {
            steps {
                sh 'echo "Scanning for vulnerabilities..."'
            }
        }

        stage('Docker Push') {
            steps {
                sh 'echo "Pushing Docker image to registry..."'
            }
        }

        stage('Update-K8s-Deployment'){
            steps {
                sh 'echo "Updating Kubernetes deployment..."'
            }
        }
        
        stage('Test') {
            steps {
                sh 'echo "Testing..."'
            }
        }
        
        stage('Deploy') {
            steps {
                sh 'echo "Deploying..."'
            }
        }
    }
    
    post {
        // Clean after build
        always {
            cleanWs(cleanWhenNotBuilt: false,
                    deleteDirs: true,
                    disableDeferredWipeout: true,
                    notFailBuild: true,
                    patterns: [[pattern: '.gitignore', type: 'INCLUDE'],
                               [pattern: '.propsfile', type: 'EXCLUDE']])
        }
    }
}